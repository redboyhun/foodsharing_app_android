<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FoodsharingApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Tertiary brand color. -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Background and Surface -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface_pure</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Foodsharing.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Foodsharing.HeadlineMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Foodsharing.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Foodsharing.BodyMedium</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Foodsharing.LabelMedium</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Foodsharing.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Foodsharing.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Foodsharing.Large</item>
    </style>

    <style name="TextAppearance.Foodsharing.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.Foodsharing.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.Foodsharing.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.Foodsharing.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="TextAppearance.Foodsharing.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="ShapeAppearance.Foodsharing.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Foodsharing.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Foodsharing.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.Foodsharing.Circular" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.Foodsharing.Button.Pill" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Foodsharing.Circular</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.Foodsharing.TextInputLayout.Pill" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Foodsharing.Large</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxBackgroundColor">@color/surface_pure</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
