<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/nav_graph"
app:startDestination="@id/nearbyBasketsFragment" >

<!-- Nearby Baskets -->
<fragment
    android:id="@+id/nearbyBasketsFragment"
    android:name="com.foodsharing.app.ui.baskets.NearbyBasketsFragment"
    android:label="@string/nearby_baskets"
    tools:layout="@layout/fragment_nearby_baskets" >

    <action
        android:id="@+id/actionNearbyBasketsToDetail"
        app:destination="@id/basketDetailFragment" />

</fragment>

<!-- My Baskets (accessible from nav but not in bottom nav directly) -->
<fragment
    android:id="@+id/myBasketsFragment"
    android:name="com.foodsharing.app.ui.baskets.MyBasketsFragment"
    android:label="@string/my_baskets"
    tools:layout="@layout/fragment_my_baskets" >

    <action
        android:id="@+id/actionMyBasketsToDetail"
        app:destination="@id/basketDetailFragment" />
    <action
        android:id="@+id/action_myBaskets_to_addEditBasket"
        app:destination="@id/addEditBasketFragment" />

</fragment>
<fragment
    android:id="@+id/basketDetailFragment"
    android:name="com.foodsharing.app.ui.baskets.BasketDetailFragment"
    android:label="@string/basket_detail"
    tools:layout="@layout/fragment_basket_detail" >

    <argument
        android:name="basketId"
        app:argType="integer" />

</fragment>
<fragment
    android:id="@+id/addEditBasketFragment"
    android:name="com.foodsharing.app.ui.baskets.AddEditBasketFragment"
    android:label="@string/add_basket"
    tools:layout="@layout/fragment_add_edit_basket" />

<!-- Conversations -->
<fragment
    android:id="@+id/conversationsFragment"
    android:name="com.foodsharing.app.ui.conversations.ConversationsFragment"
    android:label="@string/conversations"
    tools:layout="@layout/fragment_conversations" >

    <action
        android:id="@+id/actionConversationsToChat"
        app:destination="@id/chatFragment" />

</fragment>
<fragment
    android:id="@+id/chatFragment"
    android:name="com.foodsharing.app.ui.conversations.ChatFragment"
    android:label="@string/chat"
    tools:layout="@layout/fragment_chat" >

    <argument
        android:name="conversationId"
        app:argType="integer" />

</fragment>

<!-- Pickups -->
<fragment
    android:id="@+id/pickupsFragment"
    android:name="com.foodsharing.app.ui.pickups.PickupsFragment"
    android:label="@string/pickups"
    tools:layout="@layout/fragment_pickups" />

<!-- Profile -->
<fragment
    android:id="@+id/profileFragment"
    android:name="com.foodsharing.app.ui.profile.ProfileFragment"
    android:label="@string/profile"
    tools:layout="@layout/fragment_profile" >

    <action
        android:id="@+id/action_profile_to_settings"
        app:destination="@id/settingsFragment" />
    <action
        android:id="@+id/action_profile_to_myBaskets"
        app:destination="@id/myBasketsFragment" />

</fragment>
<fragment
    android:id="@+id/settingsFragment"
    android:name="com.foodsharing.app.ui.settings.SettingsFragment"
    android:label="@string/settings"
    tools:layout="@layout/fragment_settings" />
</navigation>